{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toban",
  "main": "server/worker.ts",
  // toban.app のカスタムドメインだけで届ける。workers.dev とバージョンの
  // プレビュー URL は開けない。次の deploy で効く。
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    // single-page-application だと、実体の無い /package.json や /.well-known/* も
    // index.html を 200 で返してしまう。画面のパス（ドットなし）は Worker が index.html を返す。
    "not_found_handling": "none",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "toban-maker-db",
      // ここは書き換えない。pnpm build が scripts/prepare-wrangler-config.mjs で
      // CLOUDFLARE_D1_DATABASE_ID に置き換えた wrangler.deploy.jsonc を作り、それでビルドする。
      "database_id": "__CLOUDFLARE_D1_DATABASE_ID__",
      "preview_database_id": "__CLOUDFLARE_D1_PREVIEW_DATABASE_ID__",
      "migrations_dir": "server/db/migrations",
    },
  ],
  "triggers": {
    "crons": ["0 3 * * *"],
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
}
