{
  "name": "toban",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "deploy:cf": "node scripts/cloudflare.ts deploy",
    "preview": "vite preview --host",
    "check": "tsc --noEmit && vue-tsc --noEmit",
    "lint": "eslint .",
    "db:migrate:local": "node scripts/cloudflare.ts migrate-local",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "og:generate": "node scripts/generate-og-image.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@lucide/vue": "1.66.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "motion-v": "2.10.0",
    "nanoid": "^6.0.2",
    "qrcode-generator": "^2.0.4",
    "vue": "3.5.44",
    "vue-router": "^5.4.0",
    "vue-sonner": "^2.0.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.9",
    "@cloudflare/workers-types": "^5.20261102.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/test-utils": "^2.5.1",
    "cf": "1.0.0-beta.26",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "jsdom": "^30.1.3",
    "miniflare": "5.20261023.3-beta",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "engines": {
    "node": "^24.22.0 || ^26.12.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.29.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ],
    "overrides": {
      "@rollup/plugin-node-resolve@16.0.3>deepmerge": "-",
      "glob@>=9.0.0 <14.0.2": "14.0.3",
      "minimatch@>=7.0.0 <11.0.1": "11.0.3",
      "miniflare@5.20261012.0-beta>undici": "7.30.1",
      "miniflare@5.20261012.1-beta>undici": "7.30.1"
    },
    "patchedDependencies": {
      "@rollup/plugin-node-resolve@16.0.3": "patches/@rollup__plugin-node-resolve@16.0.3.patch"
    }
  }
}
